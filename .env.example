# ============================================================================
# RigelStore — Contoh Environment Variables
# ----------------------------------------------------------------------------
# File ini HANYA berisi NAMA variabel, TANPA nilai rahasia.
# Salin ke `.env.local` (untuk lokal) atau isi di dashboard Vercel/Supabase
# (untuk produksi), lalu isi nilainya di sana. JANGAN commit file .env.local.
#
# Aturan emas: TIDAK ADA secret yang ditulis di dalam kode. Semua lewat env.
# Tidak semua variabel dibutuhkan sekaligus — masing-masing baru dipakai saat
# fasenya tiba (lihat DEPLOYMENT.md dan ARCHITECTURE.md).
# ============================================================================

# --- Umum / Aplikasi -------------------------------------------------------
NODE_ENV=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=

# --- Database (Supabase / PostgreSQL) — Fase 1 -----------------------------
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Autentikasi & Sesi (Auth) — Fase 1 ------------------------------------
AUTH_SECRET=
AUTH_URL=
SESSION_SECRET=

# --- Enkripsi kredensial unik saat disimpan (at rest) — Fase 2/4 -----------
CREDENTIAL_ENCRYPTION_KEY=

# --- Penyimpanan File (Cloudflare R2 / Supabase Storage) — Fase 2/4 --------
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
SIGNED_URL_TTL_SECONDS=

# --- Payment Gateway QRIS (mulai dari Midtrans, mode Sandbox) — Fase 3 -----
PAYMENT_PROVIDER=
PAYMENT_ENVIRONMENT=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_WEBHOOK_SIGNATURE_SECRET=
PAYMENT_RESERVATION_MINUTES=

# --- Telegram Bot (dari @BotFather) — Fase 6 -------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- Email (invoice + link download, mis. Resend) — Fase 4 -----------------
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# --- Cron / Background Jobs — Fase 3+ --------------------------------------
CRON_SECRET=

# --- AI API (draft produk & post) — Fase 9/10 ------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Social Media API (Facebook / Instagram / Threads) — Fase 10 -----------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
THREADS_ACCESS_TOKEN=

# --- Monitoring / Error Reporting — Fase 8 ---------------------------------
MONITORING_DSN=
